// ─── LEAD PROTECTION, DEALS & COMMISSIONS ───────────────

model LeadOwnershipHistory {
  id                String    @id @default(cuid())
  leadId            String
  action            String // ASSIGNED | TRANSFERRED | EXTENDED | EXPIRED | DUPLICATE_RESOLVED | REVERTED
  fromBrokerId      String?
  toBrokerId        String?
  changedById       String
  reason            String?
  previousExpiresAt DateTime?
  newExpiresAt      DateTime?
  metadata          String? // JSON string
  createdAt         DateTime  @default(now())

  lead       Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromBroker BrokerProfile? @relation("OwnershipFrom", fields: [fromBrokerId], references: [id], onDelete: SetNull)
  toBroker   BrokerProfile? @relation("OwnershipTo", fields: [toBrokerId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([action])
  @@index([createdAt])
}

model Deal {
  id              String    @id @default(cuid())
  leadId          String // a deal must always trace back to a protected lead
  brokerId        String? // attributed broker (snapshot of lead owner at deal time)
  developerId     String
  projectId       String
  unitId          String?
  status          String    @default("RESERVATION") // RESERVATION | CONTRACT | SOLD | CANCELLED | LOST
  dealValue       Float?
  currency        String    @default("EGP")
  reservationDate DateTime?
  contractDate    DateTime?
  saleDate        DateTime?
  source          String    @default("PLATFORM") // PLATFORM | OFF_PLATFORM_REPORT
  reportedById    String? // user who reported an off-platform transaction
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  lead          Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  broker        BrokerProfile?   @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  developer     DeveloperProfile @relation(fields: [developerId], references: [id], onDelete: Cascade)
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  unit          Unit?            @relation(fields: [unitId], references: [id], onDelete: SetNull)
  commissions   Commission[]
  brokerReviews BrokerReview[]
  disputes      DealDispute[]

  @@index([leadId])
  @@index([brokerId])
  @@index([developerId])
  @@index([projectId])
  @@index([unitId])
  @@index([status])
  @@index([createdAt])
}

model Commission {
  id             String    @id @default(cuid())
  dealId         String
  ruleId         String?
  status         String    @default("PENDING") // PENDING | APPROVED | INVOICED | DUE | PAID | CANCELLED | DISPUTED
  dealValue      Float
  currency       String    @default("EGP")
  totalPct       Float
  estateaiPct    Float
  brokerPct      Float
  otherPct       Float     @default(0)
  otherLabel     String?
  totalAmount    Float
  estateaiAmount Float
  brokerAmount   Float
  otherAmount    Float     @default(0)
  dueDate        DateTime?
  paidDate       DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  deal Deal            @relation(fields: [dealId], references: [id], onDelete: Cascade)
  rule CommissionRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([dealId])
  @@index([status])
}

model CommissionRule {
  id           String   @id @default(cuid())
  name         String
  developerId  String? // null = platform-wide default rule
  projectId    String? // project-specific rule (more specific wins)
  totalPct     Float
  estateaiPct  Float
  brokerPct    Float
  otherPct     Float    @default(0)
  otherLabel   String?
  isActive     Boolean  @default(true)
  isDefault    Boolean  @default(false) // platform default when no other rule matches
  priority     Int      @default(0)
  minDealValue Float?
  maxDealValue Float?
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  developer   DeveloperProfile? @relation(fields: [developerId], references: [id], onDelete: Cascade)
  project     Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  commissions Commission[]

  @@index([developerId])
  @@index([projectId])
  @@index([minDealValue])
  @@index([maxDealValue])
}

model DeveloperPartnership {
  id                  String    @id @default(cuid())
  developerId         String    @unique
  status              String    @default("PENDING") // PENDING | UNDER_REVIEW | APPROVED | ACTIVE | SUSPENDED | REJECTED | EXPIRED
  allProjectsApproved Boolean   @default(false)
  approvedProjectIds  String    @default("[]") // JSON array of project ids
  commissionAgreement String? // free-text/JSON terms
  leadProtectionDays  Int? // developer-specific protection period override
  allowedBrokerIds    String    @default("[]") // JSON array; empty = no per-broker restriction
  blockedBrokerIds    String    @default("[]") // JSON array; always wins
  startDate           DateTime?
  endDate             DateTime?
  terms               String?
  isActive            Boolean   @default(true)
  reviewedById        String?
  reviewNote          String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  developer DeveloperProfile @relation(fields: [developerId], references: [id], onDelete: Cascade)
}

model BrokerProjectAccess {
  id          String    @id @default(cuid())
  brokerId    String
  developerId String?
  projectId   String?
  access      String    @default("APPROVED") // APPROVED | BLOCKED
  expiresAt   DateTime?
  createdById String?
  notes       String?
  createdAt   DateTime  @default(now())

  broker    BrokerProfile     @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  developer DeveloperProfile? @relation(fields: [developerId], references: [id], onDelete: Cascade)
  project   Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([brokerId, developerId, projectId])
  @@index([brokerId])
  @@index([developerId])
  @@index([projectId])
}

