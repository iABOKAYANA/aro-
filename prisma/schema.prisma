  watchAlerts           Boolean @default(true) // F7: price/availability alerts for watched items

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// An Expo push token registered by the mobile app.
// One row per (user, token): reinstalling or moving to a new device upserts
// `lastSeenAt` rather than stacking duplicates, and the unique pair lets a
// sign-out revoke exactly the token that signed out. Tokens that stop working
// are pruned on send (see src/lib/push.ts) instead of by a scheduled sweep.
model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  token      String // ExponentPushToken[xxxxxxxx] as issued by expo-notifications
  platform   String   @default("ios") // ios | android | web
  deviceName String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
}

model MarketingConsent {
  id       String    @id @default(cuid())
  userId   String
  channel  String
  purpose  String
  isActive Boolean   @default(true)
  optedAt  DateTime  @default(now())
  optedOut DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, purpose])
}

