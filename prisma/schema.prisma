generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── USER & AUTH ─────────────────────────────────────────

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  phone             String?   @unique
  passwordHash      String?
  name              String
  nameArabic        String?
  avatar            String?
  role              String    @default("BUYER") // CEO | ADMIN | BROKER | DEVELOPER | SELLER | BUYER
  status            String    @default("PENDING") // PENDING | ACTIVE | SUSPENDED | REJECTED | DISABLED
  isVerified        Boolean   @default(false)
  isActive          Boolean   @default(false)
  preferredLang     String    @default("en")
  preferredCurrency String    @default("EGP")
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  profile               UserProfile?
  brokerProfile         BrokerProfile?
  developerProfile      DeveloperProfile?
  sellerProfile         SellerProfile?
  inquiries             Inquiry[]
  favorites             Favorite[]
  savedSearches         SavedSearch[]
  viewings              Viewing[]               @relation("ViewingUser")
  appointments          Appointment[]           @relation("AppointmentUser")
  notifications         Notification[]
  auditLogs             AuditLog[]
  sessions              Session[]
  accounts              Account[]
  documents             UserDocument[]
  notificationsPref     NotificationPreference?
  aiConversations       AIConversation[]
  aiSearchHistory       AISearchHistory[]
  watches               Watch[]
  marketingConsents     MarketingConsent[]
  brokerClients         BrokerClient[]          @relation("ClientBroker")
  approvalRequests      ApprovalRequest[]       @relation("RequestedApprovals")
  reviewedApprovals     ApprovalRequest[]       @relation("ReviewedApprovals")
  accessRequests        AccessRequest[]         @relation("AccessRequestUser")
  reviewedAccess        AccessRequest[]         @relation("AccessRequestReviewer")
  invitationsSent       Invitation[]            @relation("InvitationSender")
  invitedUser           Invitation[]            @relation("InvitationUser")
  pushSubscriptions     PushSubscription[]
  sharedComparisons     SharedComparison[]
  reviews               Review[]
  voiceNotes            VoiceNote[]
  brokerReviewsGiven    BrokerReview[]          @relation("BrokerReviewRater")
  brokerReviewsReceived BrokerReview[]          @relation("BrokerReviewBroker")
  brokerTargets         BrokerTarget[]          @relation("BrokerTargetBroker")
  dealDisputes          DealDispute[]           @relation("DealDisputeClaimant")
  editRequests          EditRequest[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserProfile {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  dateOfBirth            DateTime?
  gender                 String?
  nationalId             String?
  passportNumber         String?
  address                String?
  city                   String?
  governorate            String?
  country                String    @default("EGP")
  bio                    String?
  budgetMin              Float?
  budgetMax              Float?
  preferredPropertyTypes String    @default("[]") // JSON array
  preferredAreas         String    @default("[]") // JSON array
  language               String    @default("en")

  // ─── AI Client DNA (F1) — derived from REAL interactions only ───
  dnaData       String    @default("{}") // JSON: structured profile {budget,locations,property,financial,intent,urgency,...}
  dnaEvidence   String    @default("[]") // JSON array: [{field,value,source,refId,at}] — every claim traces to an interaction
  dnaConfidence Float     @default(0) // 0..1 — based on evidence count/diversity
  dnaUpdatedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── BROKER ──────────────────────────────────────────────

model BrokerProfile {
  id               String  @id @default(cuid())
  userId           String  @unique
  licenseNumber    String?
  agencyName       String?
  agencyNameArabic String?
  specialization   String  @default("[]") // JSON array
  yearsExperience  Int?
  totalDeals       Int     @default(0)
  rating           Float   @default(0)
  reviewCount      Int     @default(0)
  commissionRate   Float?
  bio              String?
  coverImage       String?
  socialLinks      String? // JSON
  isVerified       Boolean @default(false)
  featuredRank     Int?
  serviceAreas     String  @default("[]") // JSON array
  languagesSpoken  String  @default("[\"en\",\"ar\"]") // JSON array

  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  leads         Lead[]
  clients       BrokerClient[]
  viewings      Viewing[]              @relation("ViewingBroker")
  deals         Deal[]
  projectAccess BrokerProjectAccess[]
  ownershipFrom LeadOwnershipHistory[] @relation("OwnershipFrom")
  ownershipTo   LeadOwnershipHistory[] @relation("OwnershipTo")
}

model BrokerClient {
  id           String   @id @default(cuid())
  brokerId     String
  clientId     String
  relationship String?
  notes        String?
  createdAt    DateTime @default(now())

  broker BrokerProfile @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  client User          @relation("ClientBroker", fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([brokerId, clientId])
}

// ─── DEVELOPER ───────────────────────────────────────────

model DeveloperProfile {
  id                String  @id @default(cuid())
  userId            String  @unique
  companyName       String
  companyNameArabic String?
  logo              String?
  coverImage        String?
  crNumber          String?
  taxId             String?
  website           String?
  foundedYear       Int?
  description       String?
  descriptionArabic String?
  headquarters      String?
  totalProjects     Int     @default(0)
  totalUnitsSold    Int     @default(0)
  rating            Float   @default(0)
  reviewCount       Int     @default(0)
  isVerified        Boolean @default(false)
  featuredRank      Int?
  socialLinks       String? // JSON
  contactEmail      String?
  contactPhone      String?
  editMode          String  @default("REQUEST") // DIRECT | REQUEST — REQUEST default per owner approval (direct PATCH/DELETE blocked, edit-request flow only)

  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects        Project[]
  leads           Lead[]
  deals           Deal[]
  commissionRules CommissionRule[]
  partnership     DeveloperPartnership?
  brokerAccess    BrokerProjectAccess[]
}

// ─── LOCATIONS ───────────────────────────────────────────

model Governorate {
  id         String  @id @default(cuid())
  name       String  @unique
  nameArabic String
  nameSlug   String  @unique
  latitude   Float?
  longitude  Float?
  image      String?
  isActive   Boolean @default(true)
  sortOrder  Int     @default(0)

  cities   City[]
  projects Project[]
}

model City {
  id            String  @id @default(cuid())
  name          String
  nameArabic    String
  nameSlug      String
  governorateId String
  latitude      Float?
  longitude     Float?
  image         String?
  isActive      Boolean @default(true)
  sortOrder     Int     @default(0)

  governorate Governorate @relation(fields: [governorateId], references: [id], onDelete: Cascade)
  districts   District[]
  projects    Project[]

  @@unique([governorateId, name])
}

model District {
  id         String  @id @default(cuid())
  name       String
  nameArabic String
  nameSlug   String
  cityId     String
  latitude   Float?
  longitude  Float?
  image      String?
  isActive   Boolean @default(true)
  sortOrder  Int     @default(0)

  city     City      @relation(fields: [cityId], references: [id], onDelete: Cascade)
  projects Project[]

  @@unique([cityId, name])
}

// ─── PROJECTS / COMPOUNDS ────────────────────────────────

model Project {
  id                String  @id @default(cuid())
  developerId       String
  name              String
  nameArabic        String?
  slug              String  @unique
  tagline           String?
  taglineArabic     String?
  description       String?
  descriptionArabic String?
  coverImage        String?
  gallery           String  @default("[]") // JSON array
  videoUrl          String?
  virtualTourUrl    String?
  panoramaImages    String? // JSON array of 360° image URLs

  governorateId String?
  cityId        String?
  districtId    String?
  address       String?
  latitude      Float?
  longitude     Float?
  lat           Float?
  lng           Float?
  googleMapsUrl String?

  propertyTypes         String    @default("[]") // JSON array
  listingTypes          String    @default("[]") // JSON array
  status                String    @default("COMING_SOON")
  approvalStatus        String    @default("DRAFT") // DRAFT | PENDING | APPROVED | REJECTED | PUBLISHED | HIDDEN | ARCHIVED
  rejectionReason       String?
  totalUnits            Int?
  totalArea             Float?
  completionPercent     Int?      @default(0)
  deliveryDate          DateTime?
  deliveryTerms         String?
  startPrice            Float?
  endPrice              Float?
  pricePerSqm           Float?
  downPaymentMin        Float?
  installmentYears      Int?
  MaintenanceFeePercent Float?
  compoundArea          Float?

  metaTitle       String?
  metaDescription String?
  keywords        String  @default("[]") // JSON array
  dataTrust       String  @default("{}") // F10: JSON {field:{status,source,verifiedAt,verifiedById,updatedAt}}

  isFeatured    Boolean @default(false)
  isVerified    Boolean @default(false)
  isActive      Boolean @default(true)
  viewCount     Int     @default(0)
  favoriteCount Int     @default(0)
  inquiryCount  Int     @default(0)
  featuredRank  Int?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  developer        DeveloperProfile      @relation(fields: [developerId], references: [id], onDelete: Cascade)
  governorate      Governorate?          @relation(fields: [governorateId], references: [id])
  city             City?                 @relation(fields: [cityId], references: [id])
  district         District?             @relation(fields: [districtId], references: [id])
  units            Unit[]
  phases           ProjectPhase[]
  milestones       ProjectMilestone[]
  paymentPlans     PaymentPlan[]
  amenities        ProjectAmenity[]
  nearbyPlaces     NearbyPlace[]
  masterPlanImages MasterPlanImage[]
  brochures        ProjectBrochure[]
  blogs            Blog[]
  viewings         Viewing[]
  leads            Lead[]
  deals            Deal[]
  commissionRules  CommissionRule[]
  brokerAccess     BrokerProjectAccess[]
  reviews          Review[]
}

model ProjectPhase {
  id           String    @id @default(cuid())
  projectId    String
  name         String
  nameArabic   String?
  description  String?
  status       String    @default("COMING_SOON")
  deliveryDate DateTime?
  totalUnits   Int?
  startPrice   Float?
  endPrice     Float?
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  units        Unit[]
  paymentPlans PaymentPlan[]
}

model Unit {
  id                 String   @id @default(cuid())
  projectId          String
  phaseId            String?
  name               String
  nameArabic         String?
  unitNumber         String?
  floor              Int?
  unitType           String // APARTMENT | VILLA | etc.
  listingType        String // SALE | RENT | etc.
  status             String   @default("AVAILABLE")
  bedrooms           Int?
  bathrooms          Int?
  area               Float
  netArea            Float?
  roofArea           Float?
  gardenArea         Float?
  price              Float
  pricePerSqm        Float?
  currency           String   @default("EGP")
  downPayment        Float?
  monthlyInstallment Float?
  installmentYears   Int?
  deliveryTerms      String?
  finishingType      String?
  view               String?
  isCorner           Boolean  @default(false)
  hasBalcony         Boolean  @default(false)
  hasParking         Boolean  @default(false)
  parkingNumber      String?
  gallery            String   @default("[]") // JSON array
  floorPlan          String?
  brochureUrl        String?
  isFeatured         Boolean  @default(false)
  isSample           Boolean  @default(false)
  viewCount          Int      @default(0)
  favoriteCount      Int      @default(0)
  metaTitle          String?
  metaDescription    String?
  slug               String?  @unique
  dataTrust          String   @default("{}") // F10: JSON {price:{status,source,verifiedAt,updatedAt}}
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase        ProjectPhase?  @relation(fields: [phaseId], references: [id])
  leads        Lead[]
  deals        Deal[]
  inquiries    Inquiry[]
  favorites    Favorite[]
  viewings     Viewing[]
  priceHistory PriceHistory[]
}

model UnitFeature {
  id     String  @id @default(cuid())
  name   String
  nameAr String?
}

model PriceHistory {
  id         String   @id @default(cuid())
  unitId     String
  price      Float
  change     Float?
  reason     String?
  recordedAt DateTime @default(now())

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)
}

// ─── PAYMENT PLANS ───────────────────────────────────────

model PaymentPlan {
  id                 String   @id @default(cuid())
  projectId          String
  phaseId            String?
  name               String
  nameArabic         String?
  description        String?
  downPaymentPct     Float
  installmentYears   Int
  maintenanceFeePct  Float?
  semiAnnualPct      Float?
  deliveryPaymentPct Float?
  cashDiscount       Float?
  isDefault          Boolean  @default(false)
  isActive           Boolean  @default(true)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  project    Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase      ProjectPhase?      @relation(fields: [phaseId], references: [id])
  milestones PaymentMilestone[]
}

model PaymentMilestone {
  id            String  @id @default(cuid())
  paymentPlanId String
  name          String
  nameArabic    String?
  percentage    Float
  monthNumber   Int?
  description   String?
  sortOrder     Int     @default(0)

  paymentPlan PaymentPlan @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)
}

// ─── AMENITIES ───────────────────────────────────────────

model Amenity {
  id         String  @id @default(cuid())
  name       String  @unique
  nameArabic String
  icon       String?
  image      String?
  category   String  @default("LIFESTYLE")
  isActive   Boolean @default(true)
  sortOrder  Int     @default(0)

  projects ProjectAmenity[]
}

model ProjectAmenity {
  id        String  @id @default(cuid())
  projectId String
  amenityId String
  isPremium Boolean @default(false)
  notes     String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([projectId, amenityId])
}

model NearbyPlace {
  id        String @id @default(cuid())
  projectId String
  name      String
  type      String
  distance  Float?
  driveTime Int?
  latitude  Float?
  longitude Float?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ─── MEDIA ───────────────────────────────────────────────

model MasterPlanImage {
  id        String  @id @default(cuid())
  projectId String
  url       String
  caption   String?
  sortOrder Int     @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectBrochure {
  id        String   @id @default(cuid())
  projectId String
  url       String
  name      String
  fileSize  Int?
  pageCount Int?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ─── INQUIRIES & LEADS ──────────────────────────────────

model Inquiry {
  id          String    @id @default(cuid())
  userId      String?
  unitId      String?
  name        String
  email       String?
  phone       String
  message     String?
  type        String    @default("GENERAL")
  status      String    @default("NEW")
  source      String    @default("WEBSITE")
  priority    Int       @default(0)
  assignedTo  String?
  notes       String?
  contactedAt DateTime?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User?             @relation(fields: [userId], references: [id])
  unit      Unit?             @relation(fields: [unitId], references: [id])
  responses InquiryResponse[]
}

model InquiryResponse {
  id        String   @id @default(cuid())
  inquiryId String
  senderId  String?
  message   String
  createdAt DateTime @default(now())

  inquiry Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
}

model Lead {
  id                     String    @id @default(cuid())
  leadCode               String?   @unique // EA-10482 (EstateAI public lead id)
  brokerId               String? // null = unassigned (e.g. auto-created from a booking)
  developerId            String? // developer this lead is registered against
  projectId              String?
  unitId                 String?
  name                   String
  email                  String?
  phone                  String
  normalizedPhone        String? // digits-only copy for duplicate matching
  normalizedEmail        String? // lowercased copy for duplicate matching
  source                 String    @default("WEBSITE")
  status                 String    @default("NEW")
  reviewStatus           String    @default("ACTIVE") // ACTIVE | DUPLICATE_REVIEW | TRANSFERRED | CLOSED
  duplicateOfId          String? // lead id that won a duplicate match (plain scalar, no FK)
  duplicateNote          String? // neutral explanation shown instead of owner details
  resolutionNote         String?
  resolvedById           String?
  resolvedAt             DateTime?
  // Lead protection (EstateAI attribution window)
  protectionStartsAt     DateTime?
  protectionExpiresAt    DateTime?
  protectionDays         Int? // snapshot of the rule applied at registration
  protectionSource       String? // PLATFORM | DEVELOPER | PROJECT | MANUAL
  budgetMin              Float?
  budgetMax              Float?
  preferredPropertyTypes String    @default("[]") // JSON array
  preferredAreas         String    @default("[]") // JSON array
  notes                  String?
  contactedAt            DateTime?
  lastContactAt          DateTime?
  nextFollowUp           DateTime?
  convertedAt            DateTime?
  lostReason             String?
  score                  Int?      @default(0)
  tags                   String    @default("[]") // JSON array
  createdBy              String? // user id who registered the lead
  updatedBy              String?
  lastActivityAt         DateTime?
  jobFlags               String    @default("{}") // JSON: {expiringNotified, expiredNotified, inactivityNotified}
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  broker           BrokerProfile?         @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  developer        DeveloperProfile?      @relation(fields: [developerId], references: [id], onDelete: SetNull)
  project          Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  unit             Unit?                  @relation(fields: [unitId], references: [id], onDelete: SetNull)
  activities       LeadActivity[]
  viewings         Viewing[]
  deals            Deal[]
  ownershipHistory LeadOwnershipHistory[]
  voiceNotes       VoiceNote[]

  @@index([status])
  @@index([reviewStatus])
  @@index([createdAt])
  @@index([brokerId])
  @@index([developerId])
  @@index([projectId])
  @@index([unitId])
  @@index([normalizedPhone])
  @@index([normalizedEmail])
  @@index([protectionExpiresAt])
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  type      String
  content   String?
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

// ─── VIEWINGS & APPOINTMENTS ─────────────────────────────

model Viewing {
  id           String   @id @default(cuid())
  userId       String? // null = guest booking (no account)
  unitId       String?
  projectId    String?
  brokerId     String?
  leadId       String?
  scheduledAt  DateTime
  duration     Int      @default(30)
  status       String   @default("scheduled")
  meetingType  String   @default("in_person") // in_person | online
  meetingLink  String?
  contactPhone String? // phone the client leaves when booking
  notes        String?
  feedback     String?
  rating       Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user    User?          @relation("ViewingUser", fields: [userId], references: [id])
  unit    Unit?          @relation(fields: [unitId], references: [id])
  project Project?       @relation(fields: [projectId], references: [id])
  broker  BrokerProfile? @relation("ViewingBroker", fields: [brokerId], references: [id])
  lead    Lead?          @relation(fields: [leadId], references: [id])
  review  Review?
}

model Appointment {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  scheduledAt DateTime
  duration    Int      @default(30)
  type        String
  status      String   @default("scheduled")
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation("AppointmentUser", fields: [userId], references: [id])
}

// ─── FAVORITES & SAVED SEARCHES ──────────────────────────

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  unitId    String?
  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit Unit? @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([userId, unitId])
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  name      String
  filters   String // JSON string
  notifyNew Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── FEATURE 7: PRICE & AVAILABILITY WATCH ─────────────────
model Watch {
  id             String    @id @default(cuid())
  userId         String
  targetType     String // UNIT | PROJECT
  targetId       String
  alertsEnabled  Boolean   @default(true)
  snapshot       String    @default("{}") // last notified state {price,status,...} — only notify on real change
  lastNotifiedAt DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@index([userId])
}

// ─── FEATURE 6 (+ F1 evidence): BUYER JOURNEY EVENTS ───────
model UserEvent {
  id         String   @id @default(cuid())
  userId     String? // set when authenticated
  anonId     String? // random visitor id (no PII) when anonymous
  type       String // VISIT | PROJECT_VIEW | UNIT_VIEW | SEARCH | AI_CHAT | SAVE | CONTACT | VIEWING_BOOKED | REGISTER | RESERVATION | CONTRACT | SOLD
  entityType String? // PROJECT | UNIT | LEAD | DEAL ...
  entityId   String?
  meta       String   @default("{}") // JSON
  createdAt  DateTime @default(now())

  @@index([type, createdAt])
  @@index([userId])
  @@index([anonId])
  @@index([entityType, entityId])
}

// ─── FEATURE 8: PROJECT TIMELINE ───────────────────────────
model ProjectMilestone {
  id              String    @id @default(cuid())
  projectId       String
  type            String    @default("CUSTOM") // LAUNCH | CONSTRUCTION | PROGRESS | DELIVERY | HANDOVER | CUSTOM
  title           String
  titleArabic     String?
  description     String?
  date            DateTime?
  status          String    @default("PLANNED") // PLANNED | IN_PROGRESS | COMPLETED | DELAYED
  progressPercent Int? // only when developer actually reports it
  imageUrl        String?
  sortOrder       Int       @default(0)
  approvalStatus  String    @default("APPROVED") // DRAFT | PENDING | APPROVED | REJECTED — developer submissions go PENDING
  rejectionReason String?
  submittedById   String?
  approvedById    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([approvalStatus])
}

// ─── BLOG & CONTENT ──────────────────────────────────────

model Blog {
  id          String    @id @default(cuid())
  projectId   String?
  title       String
  titleArabic String?
  slug        String    @unique
  excerpt     String?
  content     String
  coverImage  String?
  author      String?
  tags        String    @default("[]") // JSON array
  category    String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  viewCount   Int       @default(0)
