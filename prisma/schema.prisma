// ─── LEAD VOICE NOTES ───────────────────────────────────

model VoiceNote {
  id          String   @id @default(cuid())
  leadId      String
  audioUrl    String
  durationSec Int?
  createdById String
  createdAt   DateTime @default(now())

  lead      Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
