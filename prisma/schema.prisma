}

model NotificationPreference {
  id                    String  @id @default(cuid())
  userId                String  @unique
  emailInquiries        Boolean @default(true)
  emailLeads            Boolean @default(true)
  emailPayments         Boolean @default(true)
  emailViewings         Boolean @default(true)
  emailMarketing        Boolean @default(false)
  pushInquiries         Boolean @default(true)
  pushLeads             Boolean @default(true)
  pushPayments          Boolean @default(true)
  pushViewings          Boolean @default(true)
