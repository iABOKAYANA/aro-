// ─── BROKER REVIEWS ─────────────────────────────────────

model BrokerReview {
  id        String   @id @default(cuid())
  brokerId  String
  userId    String
  dealId    String?
  /// 1..5 (range validated at the API layer)
  rating    Int
  comment   String?
  /// PENDING | APPROVED | REJECTED
  status    String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt DateTime @default(now())

  broker User  @relation("BrokerReviewBroker", fields: [brokerId], references: [id], onDelete: Cascade)
  rater  User  @relation("BrokerReviewRater", fields: [userId], references: [id], onDelete: Cascade)
  deal   Deal? @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([brokerId])
  @@index([userId])
  @@index([dealId])
  @@index([status])
}

// ─── CEO POWER FEATURES: TARGETS & DISPUTES ──────────────
// Actuals are COMPUTED from deals (no stored actuals).

model BrokerTarget {
  id          String   @id @default(cuid())
  brokerId    String
  month       String // "2026-10"
  targetDeals Int      @default(0)
  targetValue Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  broker User @relation("BrokerTargetBroker", fields: [brokerId], references: [id], onDelete: Cascade)

  @@unique([brokerId, month])
  @@index([brokerId])
  @@index([month])
}

model DealDispute {
  id         String   @id @default(cuid())
  dealId     String
  claimantId String
  reason     String
  evidence   String?
  /// OPEN | APPROVED | REJECTED
  status     String   @default("OPEN") // OPEN | APPROVED | REJECTED
  resolution String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  deal     Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  claimant User @relation("DealDisputeClaimant", fields: [claimantId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@index([claimantId])
  @@index([status])
}

// ─── WHATSAPP-TO-PROJECTS PIPELINE ─────────────────────────
// StagingItem: raw WhatsApp group message(s) awaiting CEO review.
// payload is JSON: { raw, extracted, extractionEngine, mediaUrls[], suggestedProjectId?, matchScore? }.
// targetProjectId is a PLAIN SCALAR (deliberately no FK): the target may be
// deleted after a MERGE and the audit row must survive. Resolved at review time.

model StagingItem {
  id              String   @id @default(cuid())
  source          String   @default("WHATSAPP")
  groupJid        String?
  groupName       String?
  senderName      String?
  senderPhone     String?
  messageIds      String // JSON array of WhatsApp message ids
  payload         String // JSON: raw text + extracted object + mediaUrls[]
  status          String   @default("NEW") // NEW | IN_REVIEW | APPROVED | REJECTED | MERGED
  targetProjectId String? // plain scalar, no FK (see note above)
  reviewNote      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([groupJid])
}

// EditRequest: developer field-level change request (REQUEST edit mode).
// entity is PROJECT | UNIT | PLAN; field must be in the per-entity whitelist
// (see src/lib/edit-requests.ts). newValue/oldValue are strings (JSON for
// array fields); coerced to the real column type on APPROVED.

model EditRequest {
  id          String   @id @default(cuid())
  entity      String // PROJECT | UNIT | PLAN
  entityId    String
  field       String
  oldValue    String?
  newValue    String
  message     String?
  developerId String
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED
  reason      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  developer User @relation(fields: [developerId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([entity, entityId])
  @@index([developerId])
}
