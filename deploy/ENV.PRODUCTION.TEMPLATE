# GHAYA Estate — production environment template (Ubuntu VPS)
# Copy to the project root as `.env` (or `.env.production`) and fill in.
# NEVER commit the filled file. NEVER print secret values in logs/chat.
#
# REQUIRED vs OPTIONAL is marked per var. The ONLY pre-filled values are the
# two public hostnames and ports (nothing secret).

# ─── REQUIRED: database ─────────────────────────────────────────────
# Prisma datasource is sqlite (`prisma/schema.prisma`). For a single VPS keep
# SQLite: file path MUST be absolute. For Postgres, first change the provider
# in schema.prisma to postgresql, then use a postgres:// URL here.
DATABASE_URL=
# e.g. SQLite:  DATABASE_URL="file:/opt/ghaya/prisma/prod.db"
# e.g. Postgres: DATABASE_URL="postgresql://USER:PASS@localhost:5432/ghaya?schema=public"

# ─── REQUIRED: auth (NextAuth v5) ───────────────────────────────────
# Generate: openssl rand -base64 32. AUTH_SECRET wins; NEXTAUTH_SECRET is the legacy fallback.
AUTH_SECRET=
# NEXTAUTH_SECRET=  (optional legacy fallback for AUTH_SECRET)
# Canonical public URL of the PUBLIC site (used for session-cookie secure flag + mobile login).
AUTH_URL=https://ghayaestate.com
# NEXTAUTH_URL=  (optional legacy fallback for AUTH_URL)

# ─── REQUIRED: two-site split ───────────────────────────────────────
# Console hostname, read via CONSOLE_HOST env (`src/lib/app-type.ts`, `src/middleware.ts`).
# Must match the nginx console server_name and DNS.
CONSOLE_HOST=console.ghayaestate.com
# APP_MODE is set per-process in deploy/ecosystem.config.js (public→3000, console→3001).
# APP_MODE=public  (on web-public) | APP_MODE=console (on web-console). Documented here only.

# ─── REQUIRED: public base URLs ──────────────────────────────────────
# Used for email links (`src/lib/mailer.ts`) and invite links (invite route).
NEXT_PUBLIC_SITE_URL=https://ghayaestate.com
NEXT_PUBLIC_BASE_URL=

# ─── REQUIRED (if WhatsApp worker runs): shared ingest secret ───────
# Backend (`src/app/api/whatsapp/ingest/route.ts`) and worker
# (`workers/whatsapp-bot/`) MUST use the same value. Generate: openssl rand -hex 32.
WHATSAPP_INGEST_SECRET=

# ─── OPTIONAL: OAuth ────────────────────────────────────────────────
# Google login (`src/lib/auth.ts`). Leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── OPTIONAL: email ────────────────────────────────────────────────
# Driver auto-detect (`src/lib/mailer.ts`): RESEND_API_KEY → resend;
# SMTP_HOST/SMTP_URL → smtp; else file outbox at data/outbox/*.json.
# Force one explicitly with EMAIL_DRIVER=resend|smtp|outbox.
EMAIL_DRIVER=
EMAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
SMTP_URL=

# ─── OPTIONAL but STRONGLY RECOMMENDED in prod: shared blob storage ──
# Without it uploads fall back to local public/<prefix>/ dirs
# (`src/lib/blob-store.ts`) — invisible across the two PM2 processes and
# wiped on redeploy. Create in Vercel dashboard: Storage → Blob.
BLOB_READ_WRITE_TOKEN=

# ─── OPTIONAL: distributed rate limiting ────────────────────────────
# Without both vars, rate limiting is per-process in-memory (`src/lib/rate-limit.ts`).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── OPTIONAL: proxy trust ──────────────────────────────────────────
# Only needed if nginx/haproxy reaches Node from a non-loopback IP
# (`src/lib/rate-limit.ts`). Default loopback setup needs nothing.
TRUSTED_PROXY_CIDRS=

# ─── OPTIONAL: AI assistant (local Ollama defaults) ─────────────────
AI_PROVIDER=
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# ─── Set by PM2 / runtime, not by hand ──────────────────────────────
# NODE_ENV=production and PORT (3000 public / 3001 console) are set in
# deploy/ecosystem.config.js. Do not duplicate them here.

# ─── WhatsApp worker ONLY (workers/whatsapp-bot/, not Next.js) ──────
# API_BASE=  e.g. https://console.ghayaestate.com (ingest target; no trailing slash)
# MONITORED_GROUPS=  comma-separated group JIDs; empty = onboarding log-only mode

# ─── Mobile app ONLY (mobile/, EAS build-time) ───────────────────────
# EXPO_PUBLIC_API_URL=  e.g. https://ghayaestate.com

# ─── LEGACY / UNREAD (present in .env.example, NOT read by src/) ─────
# UPLOAD_DIR, MAX_FILE_SIZE, NEXT_PUBLIC_MAPBOX_TOKEN are not referenced
# anywhere under src/ or workers/ (verified by grep). Kept for compat; safe to ignore.
